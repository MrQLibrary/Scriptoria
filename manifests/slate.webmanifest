{
  "name": "Scriptoria",
  "short_name": "Scriptoria",
  "description": "Digitales Whiteboard mit Elektronik-Baukasten, Formeln und historischen Tafeln",
  "lang": "de",
  "start_url": "../index.html",
  "scope": "../",
  "id": "../",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "background_color": "#ffffff",
  "theme_color": "#2b6cff",
  "icons": [
    {
      "src": "../icons/app/slate-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icons/app/slate-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icons/app/slate-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "../icons/app/slate.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "file_handlers": [
    {
      "action": "../index.html",
      "accept": {
        "application/json": [
          ".owb"
        ]
      }
    }
  ],
  "categories": [
    "education",
    "productivity"
  ]
}